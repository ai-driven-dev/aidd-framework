{
  "name": "@ai-driven-dev/kanban-source",
  "description": "Source folder mounted by the AIDD CLI as `aidd kanban`. Never published on its own.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
