{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      },
      "correctness": {
        "noUnresolvedImports": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/example",
      "!**/temp",
      "!**/coverage",
      "!demo",
      "!.aidd",
      "!.claude",
      "!.cursor",
      "!.opencode",
      "!.specstory",
      "!.vscode",
      "!setup-test",
      "!tmp-test",
      "!tmp",
      "!.stryker-tmp",
      "!reports",
      "!**/fixtures"
    ]
  },
  "overrides": [
    {
      "includes": ["src/domain/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/application/**", "**/infrastructure/**"],
                    "message": "domain must not import application or infrastructure"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["tests/helpers/**/*.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["**/package.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
